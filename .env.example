# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# Both GEMINI_API_KEY and VITE_GEMINI_API_KEY are accepted as equivalent.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
APP_URL=
