rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E AUTORIZAÇÃO (ALLOWLIST ZERO-TRUST)
    // =========================================================================

    // 1.1: Validação de usuário aprovado na coleção /allowlist ou Administrador fixo
    // O e-mail cassiojosems@gmail.com é permanentemente autorizado. Demais usuários requerem e-mail verificado e registro ativo na allowlist.
    function isApprovedUser() {
      return request.auth != null &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.lower() == 'cassiojosems@gmail.com' ||
          (
            request.auth.token.email_verified == true &&
            exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower())) &&
            get(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower())).data.ativo == true
          )
        );
    }

    function isOwner(userId) {
      return isApprovedUser() && request.auth.uid == userId;
    }

    // Autorização de especialista / administrador baseada em Custom Claim ou e-mail administrador + status ativo na allowlist
    function isSpecialist() {
      return isApprovedUser() && (
        request.auth.token.get('specialist', false) == true ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.email.lower() == 'cassiojosems@gmail.com'
      );
    }

    function isAdmin() {
      return isApprovedUser() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.email.lower() == 'cassiojosems@gmail.com'
      );
    }

    // Verifica se o especialista possui vínculo autorizado com o aluno (ou se é admin)
    function isLinkedSpecialistForUser(userId) {
      return isAdmin() || (isSpecialist() && exists(/databases/$(database)/documents/users/$(userId)) && (
        get(/databases/$(database)/documents/users/$(userId)).data.get('assignedSpecialist', '') == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(userId)).data.get('specialistId', '') == request.auth.uid
      ));
    }

    // Verifica se o documento de usuário possui vínculo com o especialista (ou se é admin)
    function isAssignedSpecialistToDoc() {
      return isAdmin() || (isSpecialist() && (
        resource.data.get('assignedSpecialist', '') == request.auth.uid ||
        resource.data.get('specialistId', '') == request.auth.uid
      ));
    }

    // Validação de atualização de atividade pelo aluno
    function isAllowedStudentAssignmentUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let allowedKeys = ['status', 'completedAt', 'studentResponses'].toSet();
      let forbiddenKeys = [
        'specialistId',
        'studentId',
        'questions',
        'assignedAt',
        'xp',
        'specialistName',
        'subject',
        'topic'
      ].toSet();

      return !affected.hasAny(forbiddenKeys)
        && affected.hasOnly(allowedKeys)
        && request.resource.data.status in ['pending', 'completed'];
    }

    // Validação de atualização de atividade pelo especialista responsável
    function isAllowedSpecialistAssignmentUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.specialistId == request.auth.uid
        && !affected.hasAny(['specialistId', 'studentId'].toSet());
    }

    // =========================================================================
    // 1.3: COLEÇÃO ALLOWLIST (Inacessível diretamente pelo cliente)
    // =========================================================================
    match /allowlist/{email} {
      allow read, write: if false;
    }

    // =========================================================================
    // COLEÇÃO: USERS E SUBCOLEÇÕES
    // =========================================================================

    match /users/{userId} {
      // O especialista só lê alunos com vínculo autorizado. O aluno lê o próprio perfil.
      allow read: if isOwner(userId) || isAssignedSpecialistToDoc();

      // 1.4: Criação inicial: apenas do próprio documento e role 'parent' (ou qualquer role para admin)
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role == 'parent' || isAdmin());

      // 1.4: Atualização: impede alteração em 'role' e 'assignedSpecialist' para usuários comuns
      allow update: if isOwner(userId) &&
        (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'assignedSpecialist']));

      // Exclusão de conta desativada diretamente via client
      allow delete: if false;

      // -----------------------------------------------------------------------
      // SUBCOLEÇÃO 1/7: ASSIGNMENTS (Atividades de Especialistas)
      // -----------------------------------------------------------------------
      match /assignments/{assignmentId} {
        allow read: if isOwner(userId) || (isSpecialist() && (resource.data.specialistId == request.auth.uid || isLinkedSpecialistForUser(userId)));

        allow create: if isSpecialist() &&
          request.resource.data.specialistId == request.auth.uid &&
          isLinkedSpecialistForUser(userId) &&
          request.resource.data.status == 'pending' &&
          ('studentId' in request.resource.data) &&
          ('questions' in request.resource.data);

        allow update: if (isOwner(userId) && isAllowedStudentAssignmentUpdate()) ||
                         (isSpecialist() && isAllowedSpecialistAssignmentUpdate());

        allow delete: if isSpecialist() && resource.data.specialistId == request.auth.uid;
      }

      // -----------------------------------------------------------------------
      // SUBCOLEÇÃO 2/7: COMMENTS (Orientações e Pareceres)
      // -----------------------------------------------------------------------
      match /comments/{commentId} {
        allow read: if isOwner(userId) || (isSpecialist() && (resource.data.specialistId == request.auth.uid || isLinkedSpecialistForUser(userId)));
        allow create: if isSpecialist() &&
          request.resource.data.specialistId == request.auth.uid &&
          isLinkedSpecialistForUser(userId);
        allow update, delete: if isSpecialist() && resource.data.specialistId == request.auth.uid;
      }

      // -----------------------------------------------------------------------
      // SUBCOLEÇÃO 3/7: HISTORY (Histórico de Quizzes)
      // -----------------------------------------------------------------------
      match /history/{historyId} {
        allow read: if isOwner(userId) || isLinkedSpecialistForUser(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived'].toSet());
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // SUBCOLEÇÃO 4/7: BADGES (Conquistas/Medalhas)
      // -----------------------------------------------------------------------
      match /badges/{badgeId} {
        allow read: if isOwner(userId) || isLinkedSpecialistForUser(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId &&
          ('badgeId' in request.resource.data) && ('name' in request.resource.data);
        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // SUBCOLEÇÃO 5/7: TRAILS (Trilhas de Aprendizagem)
      // -----------------------------------------------------------------------
      match /trails/{trailId} {
        allow read: if isOwner(userId) || isLinkedSpecialistForUser(userId);
        allow create, update: if isOwner(userId) || isLinkedSpecialistForUser(userId);
        allow delete: if isOwner(userId) || isLinkedSpecialistForUser(userId);
      }

      // -----------------------------------------------------------------------
      // SUBCOLEÇÃO 6/7: PROGRESS (Rascunho de Quizzes em Andamento)
      // -----------------------------------------------------------------------
      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
      }

      // -----------------------------------------------------------------------
      // SUBCOLEÇÃO 7/7: MATERIALS (Materiais Anexados)
      // -----------------------------------------------------------------------
      match /materials/{materialId} {
        allow read: if isOwner(userId) || isLinkedSpecialistForUser(userId);
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // =========================================================================
    // COLEÇÃO: LEADERBOARD (Placar de Líderes)
    // =========================================================================
    match /leaderboard/{entryUserId} {
      allow read: if isApprovedUser();
      allow create: if isOwner(entryUserId) &&
        request.resource.data.keys().hasOnly(['name', 'xp', 'level', 'avatarUrl', 'updatedAt'].toSet());
      allow update: if isOwner(entryUserId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'xp', 'level', 'avatarUrl', 'updatedAt'].toSet());
      allow delete: if false;
    }

    // =========================================================================
    // 1.5: NEGAÇÃO EXPLÍCITA PARA QUALQUER CAMINHO NÃO DECLARADO
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


